/* This header defines symbols and rules universal to bare-metal execution.
 *
 * Difference from chimera-open: the peripheral base addresses below are aliased
 * from the SystemRDL-generated linker address header (chimera-top `make rdl` ->
 * sw/link/chimera_addrs.ldh), resolved via -L (see this target's CMakeLists.txt),
 * instead of being hand-typed. The MEMORY regions stay local: they encode the
 * executable's layout choices (e.g. 128K L1, 8M DRAM window, the l1_alias region
 * that has no addrmap node), not the SoC peripheral map. */

ENTRY(_start)

/* Generated by chimera-top `make rdl`; referenced as link/... so it resolves via
 * -L <chimera-top>/sw without shadowing this target's own common.ldh. */
INCLUDE link/chimera_addrs.ldh

MEMORY {
  l1_alias (rwx): ORIGIN = 0x18000000, LENGTH = 128K
  l1_c0 (rwx)   : ORIGIN = 0x40000000, LENGTH = 128K
  l1_c1 (rwx)   : ORIGIN = 0x40200000, LENGTH = 128K
  l1_c2 (rwx)   : ORIGIN = 0x40400000, LENGTH = 128K
  l1_c3 (rwx)   : ORIGIN = 0x40600000, LENGTH = 128K
  l1_c4 (rwx)   : ORIGIN = 0x40800000, LENGTH = 128K
  bootrom (rx)  : ORIGIN = 0x02000000, LENGTH = 16K
  extrom (rx)   : ORIGIN = 0x00000000, LENGTH = 48K
  memisl (rwx)  : ORIGIN = 0x48000000, LENGTH = 128K
  /* We  assume at least 8 MiB of DRAM (minimum for Linux). */
  dram (rwx)    : ORIGIN = 0x80000000, LENGTH = 8M
}

SECTIONS {
  /* Keep binaries lean */
  /DISCARD/ : { *(.riscv.attributes) *(.comment) }

  __base_l1_alias = ORIGIN(l1_alias);

  /* Peripheral base addresses: aliased from the generated chimera_addrs.ldh */
  __base_dma      = __cheshire_dma_base_addr__;
  __base_bootrom  = __cheshire_bootrom_base_addr__;
  __base_clint    = __cheshire_clint_base_addr__;
  __base_axirt    = __cheshire_axirt_base_addr__;
  /* AXI-RT guard: specific offset inside the AXI-RT region, no discrete node */
  __base_axirtgrd = 0x020C1ffc;
  __base_regs     = __cheshire_regs_base_addr__;
  __base_llc      = __cheshire_llc_base_addr__;
  __base_uart     = __cheshire_uart_base_addr__;
  __base_i2c      = __cheshire_i2c_base_addr__;
  __base_spih     = __cheshire_spih_base_addr__;
  __base_gpio     = __cheshire_gpio_base_addr__;
  __base_slink    = __cheshire_slink_base_addr__;
  __base_vga      = __cheshire_vga_base_addr__;
  __base_usb      = __cheshire_usb_base_addr__;
  __base_bus_err  = __cheshire_bus_err_base_addr__;
  __base_plic     = __cheshire_plic_base_addr__;
  __base_clic     = __cheshire_clic_base_addr__;
  __base_dram     = ORIGIN(dram);
  __base_memisl   = ORIGIN(memisl);

  __l3_heap_start = ORIGIN(dram);
  __l3_heap_end   = ORIGIN(dram) + LENGTH(dram);
}
